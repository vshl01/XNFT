# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the web app).
CORS_ORIGIN=http://localhost:3000

# ─── Database (Prisma / Postgres) ───────────────────────────────────────────
DATABASE_URL=postgresql://xnft:xnft@localhost:5432/xnft?schema=public

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -base64 48`. Use DIFFERENT
# values for access and refresh so leaking one never compromises the other.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access token lifetime (short) and refresh token lifetime (long).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Cookie domain/security for the refresh-token cookie.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
