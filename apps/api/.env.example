# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the web app).
CORS_ORIGIN=http://localhost:3000

# ─── Database (Prisma / Postgres) ───────────────────────────────────────────
DATABASE_URL=postgresql://xnft:xnft@localhost:5432/xnft?schema=public

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -base64 48`. Use DIFFERENT
# values for access and refresh so leaking one never compromises the other.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access token lifetime (short) and refresh token lifetime (long).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Cookie domain/security for the refresh-token cookie.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── Solana / on-chain ──────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
# Deployed marketplace program id (matches the contract's declare_id!).
PROGRAM_ID=Gbd3BXqzgMW5xMHp3LEER1SfHaAQ2Kgu7wb16efHaTso
# Admin wallet that signs mint/initialize/update on-chain.
# PVT_KEY: base58 secret key OR a JSON byte array (solana id.json contents).
# PUB_KEY: the matching public key (base58) — optional sanity check.
PUB_KEY=
PVT_KEY=
# Public base URL of THIS api — used to build the on-chain metadata `uri`.
API_PUBLIC_URL=http://localhost:4000
