// Prisma schema for the XNFT backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An authenticated account. `passwordHash` is an argon2id hash — the plaintext
/// password never touches the database. Email is stored normalized (lowercase).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

/// A refresh-token session. We persist a HASH of the refresh token (never the
/// token itself) so sessions can be revoked, rotated, and audited server-side.
/// Each successful refresh rotates the row, invalidating the previous token.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ip        String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum NftStatus {
  LISTED
  SOLD
  DELISTED
}

/// A minted NFT — a local mirror of on-chain state for fast reads. The chain is
/// the source of truth; this row is what the marketplace UI lists. `metadata`
/// holds the canonical xNFT metadata (see @repo/types `NftMetadata`).
model Nft {
  id          String    @id @default(uuid()) @db.Uuid
  /// On-chain mint address (base58) — the NFT's unique identity.
  mintAddress String    @unique @map("mint_address")
  name        String
  symbol      String?
  image       String
  /// URL of the off-chain Metaplex JSON this api serves (the on-chain `uri`).
  metadataUri String    @map("metadata_uri")
  /// Full canonical metadata captured at mint time.
  metadata    Json
  /// Listed price in lamports, stored as text to avoid BigInt JSON issues.
  priceLamports String  @map("price_lamports")
  status      NftStatus @default(LISTED)
  /// Mint transaction signature, set once the on-chain tx confirms.
  txSignature String?   @map("tx_signature")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("nfts")
}
